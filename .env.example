# Application
APP_NAME=Arclume
APP_ENV=development
LOG_LEVEL=INFO

# Model transport
# Use any provider that exposes an OpenAI-compatible chat-completions endpoint.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://provider.example.com/v1
LLM_MODEL=your-model-name
LLM_TIMEOUT_SECONDS=60
# Set true only when an additional LLM intent-classification call is desired.
ARCLUME_INTENT_LLM_ENABLED=false
ARCLUME_RAG_LLM_ENABLED=false
ARCLUME_RAG_REWRITE_COUNT=3
ARCLUME_RAG_MAX_CANDIDATES=30
ARCLUME_RAG_BM25_ENABLED=true
ARCLUME_RAG_RRF_K=60

# Memory infrastructure
REDIS_URL=redis://localhost:6379/0
ARCLUME_MEMORY_MAX_MESSAGES=20
ARCLUME_MEMORY_TTL_SECONDS=86400
ARCLUME_MEMORY_COMPRESS_AT=15
ARCLUME_MEMORY_RETAIN_MESSAGES=5
ARCLUME_MEMORY_SUMMARY_TTL_SECONDS=86400
# Keep this false during development to avoid extra model calls.
ARCLUME_MEMORY_LLM_ENABLED=false
ARCLUME_MEMORY_EPISODIC_TOP_K=3
ARCLUME_MEMORY_SUMMARY_MAX_CHARS=800

# Knowledge retrieval infrastructure
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_ALLOW_LOCAL_FALLBACK=false
CHROMA_CHUNK_SIZE=500

# Human-authored static Skills
ARCLUME_SKILLS_DIR=./skills
